<Window x:Class="Pro2Plus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pro2Plus.UI"
        Title="Pro2+"
        Width="1060" Height="840" MinWidth="900" MinHeight="700"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource T1}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Viewbox 让 1060×840 设计画布在小屏上等比缩放，比例始终一比一 -->
    <Viewbox Stretch="Uniform">
        <Grid x:Name="Root" Width="1060" Height="840" ClipToBounds="True">

            <!-- ═══════════ 环境光：Figma 原生 LAYER_BLUR 光场，直接贴 1:1 位图 ═══════════
                 01/03 页 = 双蓝 blob（LightA）；02/04 页 = 蓝+青+紫三 blob（LightB）。
                 用 RadialGradientBrush 近似会产生同心色带与色偏，故改为设计稿导出的 PNG。 -->
            <Grid IsHitTestVisible="False">
                <Image x:Name="GlowLayer" Width="1060" Height="840" Stretch="Fill"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Source="pack://application:,,,/Assets/Light/LightA.png"/>
                <!-- 连接 / 陀螺仪页补回设计底层的淡紫光（对应 Figma #6D4CE0 / 0.15 / blur 180 @ (720,400)） -->
                <Ellipse x:Name="GlowPurple" Width="700" Height="580"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="720,400,0,0"
                         Visibility="Collapsed">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#1F6D4CE0" Offset="0"/>
                            <GradientStop Color="#156D4CE0" Offset="0.40"/>
                            <GradientStop Color="#076D4CE0" Offset="0.72"/>
                            <GradientStop Color="#006D4CE0" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <!-- ═══════════ 极淡抖动层：只压在她光之上、内容之下 ═══════════
                 目的是打散 8-bit 渐变色带；若盖在文字与卡片之上会整屏发雾、字发虚。 -->
            <Rectangle Width="1060" Height="840" HorizontalAlignment="Left" VerticalAlignment="Top"
                       IsHitTestVisible="False" Opacity="0.10">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/Light/Noise.png"
                                TileMode="Tile" Stretch="None"
                                Viewport="0,0,128,128" ViewportUnits="Absolute"/>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ═══════════ 页面内容（下层，交互区在 x > 240）═══════════ -->
            <ContentControl x:Name="PageHost" Width="1060" Height="840"
                            HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <!-- ═══════════ 左导航 ═══════════ -->
            <Rectangle Width="208" Height="840" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="#09FFFFFF" IsHitTestVisible="False"/>
            <Rectangle Width="1" Height="840" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="207,0,0,0" Fill="#0FFFFFFF" IsHitTestVisible="False"/>

            <TextBlock Text="Pro2+" Canvas.Left="24" Canvas.Top="32" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource T1}" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="24,29,0,0" IsHitTestVisible="False"/>

            <ListBox x:Name="MainTabs" Width="208" Height="840"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemsPanel="{StaticResource NavCanvas}"
                     ItemContainerStyle="{StaticResource NavItem}"
                     SelectionChanged="Nav_SelectionChanged"/>

            <!-- 连接状态：圆点与文字放进同一行框，由布局算中线，不用手调 Margin -->
            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,752,0,0"
                  Width="160" Height="18" IsHitTestVisible="False">
                <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Fill="{Binding LinkDotBrush}"/>
                <TextBlock x:Name="DeviceStateText" Text="{Binding LinkTitle}" Margin="14,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontSize="11.5" Foreground="{StaticResource T2}"/>
            </Grid>
            <TextBlock x:Name="VersionText" Text="v1.0.1" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="24,786,0,0" FontSize="10.5" Foreground="{StaticResource T4}"
                       IsHitTestVisible="False"/>

            <!-- ═══════════ 页标题 ═══════════ -->
            <TextBlock x:Name="PageTitleText" Text="连接" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="240,32,0,0" FontSize="26" FontWeight="Bold" LineHeight="34"
                       Foreground="{StaticResource T1}" IsHitTestVisible="False"/>

            <!-- ═══════════ 窗口按钮（极淡，hover 才显）═══════════ -->
            <Button x:Name="MinimizeButton" Content="—" Style="{StaticResource WinButton}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1000,8,0,0"
                    Width="24" Height="24" WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="MinimizeButton_Click"/>
            <Button x:Name="CloseButton" Content="✕" Style="{StaticResource WinButton}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1030,8,0,0"
                    Width="24" Height="24" WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseButton_Click"/>

            <!-- ═══════════ 页脚 ═══════════ -->
            <Rectangle Height="1" Width="852" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="208,780,0,0" Fill="#0FFFFFFF" IsHitTestVisible="False"/>
            <TextBlock x:Name="FooterLeftText" Text="{Binding FooterModeText}" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="240,790,0,0" Width="320" FontSize="10.5" Foreground="{StaticResource T4}"
                       IsHitTestVisible="False"/>
            <TextBlock x:Name="FooterRightText" Text="{Binding FooterLinkText}" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="828,790,0,0" Width="200" FontSize="10.5" Foreground="{StaticResource T4}"
                       TextAlignment="Right" IsHitTestVisible="False"/>

        </Grid>
    </Viewbox>
</Window>
