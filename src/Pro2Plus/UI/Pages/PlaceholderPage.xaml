<UserControl x:Class="Pro2Plus.UI.Pages.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="28,26" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock x:Name="HeadlineText" Text="本页施工中" Style="{StaticResource CardTitle}"/>
            <TextBlock x:Name="DetailText" Text="" Margin="0,10,0,0" Style="{StaticResource BodyText}"/>
        </StackPanel>
    </Border>
</UserControl>
