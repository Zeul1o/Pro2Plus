<UserControl x:Class="Pro2Plus.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pro2Plus.UI"
             Width="1060" Height="840" Background="Transparent"
             FontFamily="Microsoft YaHei UI"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="ModalGhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource T2}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#12DCE9FF" BorderBrush="#24DCE9FF"
                                BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FDCE9FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2BDCE9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#EB5C9CFF" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F27AB0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D94A86F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Canvas Width="1060" Height="840">

        <!-- ═══════ 顶部暗场：压住窗口光场，避免卡片透出强光被“盖住” ═══════════
             卡片是 72% 透明玻璃，光场会直接透上来，视觉上像盖了一层蓝雾。
             这里在内容之下、窗口光场之上铺一层自上而下衰减的暗场（全宽，避免左右接缝），
             只削掉顶部这段的亮度，页头仍保留少量环境光。 -->
        <Rectangle Width="1060" Height="440" Canvas.Left="0" Canvas.Top="0" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#7A0B0E13" Offset="0"/>
                    <GradientStop Color="#6B0B0E13" Offset="0.20"/>
                    <GradientStop Color="#480B0E13" Offset="0.45"/>
                    <GradientStop Color="#210B0E13" Offset="0.72"/>
                    <GradientStop Color="#000B0E13" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ═══════ 可滚动内容区：上延到标题背后(y=48)，让卡片滚动时能从标题区透出 ═══════
             内容用 38px 顶部留白抵消上延量，首屏卡片视觉位置不变；底部仍止于 y=770。 -->
        <ScrollViewer x:Name="ContentScroll" Canvas.Left="240" Canvas.Top="48" Width="804" Height="722"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly" Background="Transparent"
                      ScrollChanged="ContentScroll_ScrollChanged">
            <Canvas Width="764" Height="994" HorizontalAlignment="Left">
            <!-- 顶部留白：抵消滚动区上延的 38px，首屏卡片仍在原位 -->
            <Rectangle Canvas.Left="0" Canvas.Top="0" Width="764" Height="38" Fill="Transparent"/>
            <Canvas Canvas.Left="0" Canvas.Top="38" Width="764" Height="956">

        <!-- ═══════ 设备校准 788×320 ═══════ -->
        <ContentControl Style="{StaticResource Card}" Canvas.Left="0" Canvas.Top="0" Width="764" Height="320">
            <Canvas>
                <TextBlock Canvas.Left="28" Canvas.Top="23" Text="设备校准" FontSize="10.5"
                           Foreground="{StaticResource T4}" LineHeight="15"/>
                <TextBlock Canvas.Left="496" Canvas.Top="23" FontSize="10.5"
                           Foreground="{StaticResource T4}" LineHeight="15" Width="240" TextAlignment="Right"
                           Text="{Binding GyroBiasSavedText}"/>

                <!-- 行 1 y=60 -->
                <TextBlock Canvas.Left="28" Canvas.Top="57" Text="摇杆零位校准" FontSize="14" FontWeight="Bold"
                           LineHeight="20" Foreground="{StaticResource T1}" Width="420"/>
                <TextBlock Canvas.Left="28" Canvas.Top="78" Text="松开摇杆后的回中偏移，静置手柄后自动复核"
                           FontSize="10" Foreground="{StaticResource T4}" LineHeight="15" Width="400"/>
                <Ellipse Canvas.Left="452" Canvas.Top="69" Width="6" Height="6"
                         Fill="{Binding StickCenterCalibrationState, Converter={StaticResource CalDot}}"/>
                <TextBlock Canvas.Left="466" Canvas.Top="59" FontSize="10.5"
                           Foreground="{StaticResource T2}" LineHeight="16" Width="90"
                           Text="{Binding StickCenterCalibrationState, Converter={StaticResource CalStatus}}"/>
                <TextBlock Canvas.Left="466" Canvas.Top="78" FontSize="10.5"
                           Foreground="{StaticResource T4}" LineHeight="15" Width="120"
                           Text="{Binding StickCenterCalibrationText}"/>
                <Button Canvas.Left="596" Canvas.Top="64" Width="140" Height="34" Content="重新校准"
                        Style="{StaticResource GhostButton}" FontSize="11"
                        Command="{Binding OpenCalibrationCommand}" CommandParameter="center"/>
                <Rectangle Canvas.Left="28" Canvas.Top="132" Width="708" Height="1" Fill="#0EFFFFFF"/>

                <!-- 行 2 y=144 -->
                <TextBlock Canvas.Left="28" Canvas.Top="141" Text="摇杆行程校准" FontSize="14" FontWeight="Bold"
                           LineHeight="20" Foreground="{StaticResource T1}" Width="420"/>
                <TextBlock Canvas.Left="28" Canvas.Top="162" Text="推到边缘时的最大行程，决定满舵与死区边界"
                           FontSize="10" Foreground="{StaticResource T4}" LineHeight="15" Width="400"/>
                <Ellipse Canvas.Left="452" Canvas.Top="153" Width="6" Height="6"
                         Fill="{Binding StickRangeCalibrationState, Converter={StaticResource CalDot}}"/>
                <TextBlock Canvas.Left="466" Canvas.Top="143" FontSize="10.5"
                           Foreground="{StaticResource T2}" LineHeight="16" Width="90"
                           Text="{Binding StickRangeCalibrationState, Converter={StaticResource CalStatus}}"/>
                <TextBlock Canvas.Left="466" Canvas.Top="162" FontSize="10.5"
                           Foreground="{StaticResource T4}" LineHeight="15" Width="120"
                           Text="{Binding StickRangeCalibrationText}"/>
                <Button Canvas.Left="596" Canvas.Top="148" Width="140" Height="34" Content="重新校准"
                        Style="{StaticResource GhostButton}" FontSize="11"
                        Command="{Binding OpenCalibrationCommand}" CommandParameter="range"/>
                <Rectangle Canvas.Left="28" Canvas.Top="216" Width="708" Height="1" Fill="#0EFFFFFF"/>

                <!-- 行 3 y=228 -->
                <TextBlock Canvas.Left="28" Canvas.Top="225" Text="陀螺仪校准" FontSize="14" FontWeight="Bold"
                           LineHeight="20" Foreground="{StaticResource T1}" Width="420"/>
                <TextBlock Canvas.Left="28" Canvas.Top="246" Text="校准一次自动存到配置页，下次连接直接复用"
                           FontSize="10" Foreground="{StaticResource T4}" LineHeight="15" Width="400"/>
                <Ellipse Canvas.Left="452" Canvas.Top="237" Width="6" Height="6"
                         Fill="{Binding GyroBiasCalibrationState, Converter={StaticResource CalDot}}"/>
                <TextBlock Canvas.Left="466" Canvas.Top="227" FontSize="10.5" Width="90"
                           Foreground="{StaticResource T2}" LineHeight="16"
                           Text="{Binding GyroBiasCalibrationState, Converter={StaticResource CalStatus}}"/>
                <TextBlock Canvas.Left="466" Canvas.Top="246" FontSize="10.5"
                           Foreground="{StaticResource T4}" LineHeight="15" Width="120"
                           Text="{Binding GyroBiasSavedText}"/>
                <Button Canvas.Left="596" Canvas.Top="232" Width="140" Height="34" Content="重新校准"
                        Style="{StaticResource GhostButton}" FontSize="11"
                        Command="{Binding OpenCalibrationCommand}" CommandParameter="gyro"/>

            </Canvas>
        </ContentControl>

        <!-- ═══════ 摇杆死区（按链路分开）764×200 ═══════ -->
        <ContentControl Style="{StaticResource Card}" Canvas.Left="0" Canvas.Top="336" Width="764" Height="176">
            <Canvas>
                <TextBlock Canvas.Left="28" Canvas.Top="19" Text="摇杆死区" FontSize="10.5"
                           Foreground="{StaticResource T4}" LineHeight="15"/>

                <!-- 有线 -->
                <TextBlock Canvas.Left="28" Canvas.Top="47" Text="有线" FontSize="12"
                           Foreground="{StaticResource T1}" LineHeight="18" Width="160"/>
                <TextBlock Canvas.Left="238" Canvas.Top="46" Text="{Binding WiredStickDeadzoneText}" FontSize="13"
                           FontWeight="Bold" Foreground="{StaticResource T1}" LineHeight="20"
                           Width="96" TextAlignment="Right"/>
                <StackPanel Canvas.Left="346" Canvas.Top="45" Orientation="Horizontal" Height="26">
                    <Button Width="24" Height="24" Content="−" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="wired-dz-" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="＋" Margin="4,0,0,0" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="wired-dz+" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="↺" Margin="4,0,0,0" FontSize="13" ToolTip="重置为 2%"
                            Style="{StaticResource StepButton}" Tag="wired-dz-reset" Click="Step_Click"/>
                </StackPanel>
                <Slider Canvas.Left="28" Canvas.Top="76" Width="400" Height="16"
                        Style="{StaticResource SliderThin}" Minimum="0" Maximum="204"
                        Value="{Binding WiredStickDeadzoneRaw, Mode=TwoWay}"/>

                <!-- 蓝牙 -->
                <TextBlock Canvas.Left="28" Canvas.Top="121" Text="蓝牙" FontSize="12"
                           Foreground="{StaticResource T1}" LineHeight="18" Width="160"/>
                <TextBlock Canvas.Left="238" Canvas.Top="120" Text="{Binding BleStickDeadzoneText}" FontSize="13"
                           FontWeight="Bold" Foreground="{StaticResource T1}" LineHeight="20"
                           Width="96" TextAlignment="Right"/>
                <StackPanel Canvas.Left="346" Canvas.Top="119" Orientation="Horizontal" Height="26">
                    <Button Width="24" Height="24" Content="−" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="ble-dz-" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="＋" Margin="4,0,0,0" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="ble-dz+" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="↺" Margin="4,0,0,0" FontSize="13" ToolTip="重置为 0"
                            Style="{StaticResource StepButton}" Tag="ble-dz-reset" Click="Step_Click"/>
                </StackPanel>
                <Slider Canvas.Left="28" Canvas.Top="150" Width="400" Height="16"
                        Style="{StaticResource SliderThin}" Minimum="0" Maximum="204"
                        Value="{Binding BleStickDeadzoneRaw, Mode=TwoWay}"/>

                <!-- 右栏说明 -->
                <Rectangle Canvas.Left="436" Canvas.Top="30" Width="1" Height="130" Fill="#0FFFFFFF"/>
                <TextBlock Canvas.Left="460" Canvas.Top="49" Text="按连接自动生效" FontSize="11.5" FontWeight="Bold"
                           Foreground="{StaticResource AccentInk}" LineHeight="18" Width="276"/>
                <TextBlock Canvas.Left="460" Canvas.Top="76" FontSize="10" LineHeight="16" Width="276"
                           Foreground="{StaticResource T3}" TextWrapping="Wrap"
                           Text="两种连接各存一份，自动切换。"/>
                <TextBlock Canvas.Left="460" Canvas.Top="130" FontSize="10" LineHeight="15" Width="276"
                           Foreground="{StaticResource T4}" TextWrapping="Wrap"
                           Text="越小越跟手；过小会有不可避免的漂移。"/>
            </Canvas>
        </ContentControl>

        <!-- ═══════ 按键时序 764×248 ═══════ -->
        <ContentControl Style="{StaticResource Card}" Canvas.Left="0" Canvas.Top="524" Width="764" Height="232">
            <Canvas>
                <TextBlock Canvas.Left="28" Canvas.Top="19" Text="按键时序" FontSize="10.5"
                           Foreground="{StaticResource T4}" LineHeight="15"/>

                <!-- 双击间隔 -->
                <TextBlock Canvas.Left="28" Canvas.Top="44" Text="双击间隔" FontSize="12"
                           Foreground="{StaticResource T1}" LineHeight="18" Width="160"/>
                <TextBlock Canvas.Left="238" Canvas.Top="43" Text="{Binding DoubleTapIntervalText}" FontSize="13"
                           FontWeight="Bold" Foreground="{StaticResource T1}" LineHeight="20"
                           Width="96" TextAlignment="Right"/>
                <StackPanel Canvas.Left="346" Canvas.Top="42" Orientation="Horizontal" Height="26">
                    <Button Width="24" Height="24" Content="−" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="double-" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="＋" Margin="4,0,0,0" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="double+" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="↺" Margin="4,0,0,0" FontSize="13" ToolTip="重置为 100 ms"
                            Style="{StaticResource StepButton}" Tag="double-reset" Click="Step_Click"/>
                </StackPanel>
                <Slider Canvas.Left="28" Canvas.Top="70" Width="400" Height="16"
                        Style="{StaticResource SliderThin}" Minimum="0" Maximum="500"
                        Value="{Binding DoubleTapIntervalMs, Mode=TwoWay}"/>

                <!-- 长按判定 -->
                <TextBlock Canvas.Left="28" Canvas.Top="108" Text="长按判定" FontSize="12"
                           Foreground="{StaticResource T1}" LineHeight="18" Width="160"/>
                <TextBlock Canvas.Left="238" Canvas.Top="107" Text="{Binding HoldThresholdText}" FontSize="13"
                           FontWeight="Bold" Foreground="{StaticResource T1}" LineHeight="20"
                           Width="96" TextAlignment="Right"/>
                <StackPanel Canvas.Left="346" Canvas.Top="106" Orientation="Horizontal" Height="26">
                    <Button Width="24" Height="24" Content="−" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="hold-" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="＋" Margin="4,0,0,0" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="hold+" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="↺" Margin="4,0,0,0" FontSize="13" ToolTip="重置为 250 ms"
                            Style="{StaticResource StepButton}" Tag="hold-reset" Click="Step_Click"/>
                </StackPanel>
                <Slider Canvas.Left="28" Canvas.Top="134" Width="400" Height="16"
                        Style="{StaticResource SliderThin}" Minimum="0" Maximum="800"
                        Value="{Binding HoldThresholdMs, Mode=TwoWay}"/>

                <!-- 组合键间隔 -->
                <TextBlock Canvas.Left="28" Canvas.Top="172" Text="组合键间隔" FontSize="12"
                           Foreground="{StaticResource T1}" LineHeight="18" Width="160"/>
                <TextBlock Canvas.Left="238" Canvas.Top="171" Text="{Binding ComboWindowText}" FontSize="13"
                           FontWeight="Bold" Foreground="{StaticResource T1}" LineHeight="20"
                           Width="96" TextAlignment="Right"/>
                <StackPanel Canvas.Left="346" Canvas.Top="170" Orientation="Horizontal" Height="26">
                    <Button Width="24" Height="24" Content="−" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="combo-" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="＋" Margin="4,0,0,0" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="combo+" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="↺" Margin="4,0,0,0" FontSize="13" ToolTip="重置为 150 ms"
                            Style="{StaticResource StepButton}" Tag="combo-reset" Click="Step_Click"/>
                </StackPanel>
                <Slider Canvas.Left="28" Canvas.Top="198" Width="400" Height="16"
                        Style="{StaticResource SliderThin}" Minimum="0" Maximum="600"
                        Value="{Binding ComboWindowMs, Mode=TwoWay}"/>

                <!-- 右栏说明 -->
                <Rectangle Canvas.Left="436" Canvas.Top="30" Width="1" Height="180" Fill="#0FFFFFFF"/>
                <TextBlock Canvas.Left="460" Canvas.Top="44" Text="只绑轻按立即触发" FontSize="11.5" FontWeight="Bold"
                           Foreground="{StaticResource AccentInk}" LineHeight="18" Width="276"/>
                <TextBlock Canvas.Left="460" Canvas.Top="68" FontSize="10" LineHeight="16" Width="276"
                           Foreground="{StaticResource T3}" TextWrapping="Wrap"
                           Text="同键还绑了双击或长按，会稍慢一点。"/>
                <TextBlock Canvas.Left="460" Canvas.Top="128" Text="组合键有前后顺序" FontSize="11.5" FontWeight="Bold"
                           Foreground="{StaticResource AccentInk}" LineHeight="18" Width="276"/>
                <TextBlock Canvas.Left="460" Canvas.Top="152" FontSize="10" LineHeight="16" Width="276"
                           Foreground="{StaticResource T3}" TextWrapping="Wrap"
                           Text="先按主键，再按搭子键；单独按立即出键。"/>
            </Canvas>
        </ContentControl>

        <!-- ═══════ 原生陀螺仪映射灵敏度 788×200 ═══════ -->
        <ContentControl Style="{StaticResource Card}" Canvas.Left="0" Canvas.Top="768" Width="764" Height="184">
            <Canvas>
                <TextBlock Canvas.Left="28" Canvas.Top="19" Text="陀螺仪灵敏度" FontSize="10.5"
                           Foreground="{StaticResource T4}" LineHeight="15"/>

                <!-- PS5 原生陀螺仪 -->
                <TextBlock Canvas.Left="28" Canvas.Top="47" Text="PS5 原生陀螺仪" FontSize="12"
                           Foreground="{StaticResource T1}" LineHeight="18" Width="160"/>
                <TextBlock Canvas.Left="238" Canvas.Top="46" Text="{Binding Ps5GyroSensitivityText}" FontSize="13"
                           FontWeight="Bold" Foreground="{StaticResource T1}" LineHeight="20"
                           Width="96" TextAlignment="Right"/>
                <!-- 步进组：− / ＋ / ↺ 三个按钮排成一行，整组 82px，右缘对齐滑轨（428），
                     与分隔线（436）留 8px；用 StackPanel 固定顺序，避免再出现手工坐标互相压住 -->
                <StackPanel Canvas.Left="346" Canvas.Top="45" Orientation="Horizontal" Height="26">
                    <Button Width="24" Height="24" Content="−" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="ps5-" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="＋" Margin="4,0,0,0" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="ps5+" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="↺" Margin="4,0,0,0" FontSize="13" ToolTip="重置为 1.00×"
                            Style="{StaticResource StepButton}" Tag="ps5-reset" Click="Step_Click"/>
                </StackPanel>
                <Slider Canvas.Left="28" Canvas.Top="76" Width="400" Height="16"
                        Style="{StaticResource SliderThin}" Minimum="0.25" Maximum="3.0"
                        SmallChange="0.05" Value="{Binding Ps5GyroSensitivity, Mode=TwoWay}"/>

                <!-- Pro1 原生陀螺仪 -->
                <TextBlock Canvas.Left="28" Canvas.Top="121" Text="Pro1 原生陀螺仪" FontSize="12"
                           Foreground="{StaticResource T1}" LineHeight="18" Width="160"/>
                <TextBlock Canvas.Left="238" Canvas.Top="120" Text="{Binding Pro1GyroSensitivityText}" FontSize="13"
                           FontWeight="Bold" Foreground="{StaticResource T1}" LineHeight="20"
                           Width="96" TextAlignment="Right"/>
                <!-- 步进组：− / ＋ / ↺ 三个按钮排成一行，整组 82px，右缘对齐滑轨（428），
                     与分隔线（436）留 8px；用 StackPanel 固定顺序，避免再出现手工坐标互相压住 -->
                <StackPanel Canvas.Left="346" Canvas.Top="119" Orientation="Horizontal" Height="26">
                    <Button Width="24" Height="24" Content="−" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="pro1-" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="＋" Margin="4,0,0,0" VerticalAlignment="Center"
                            Style="{StaticResource StepButton}" Tag="pro1+" Click="Step_Click"/>
                    <Button Width="24" Height="24" Content="↺" Margin="4,0,0,0" FontSize="13" ToolTip="重置为 1.00×"
                            Style="{StaticResource StepButton}" Tag="pro1-reset" Click="Step_Click"/>
                </StackPanel>
                <Slider Canvas.Left="28" Canvas.Top="150" Width="400" Height="16"
                        Style="{StaticResource SliderThin}" Minimum="0.25" Maximum="3.0"
                        SmallChange="0.05" Value="{Binding Pro1GyroSensitivity, Mode=TwoWay}"/>

                <!-- 右栏说明（与按键时序卡统一） -->
                <Rectangle Canvas.Left="436" Canvas.Top="30" Width="1" Height="130" Fill="#0FFFFFFF"/>
                <TextBlock Canvas.Left="460" Canvas.Top="49" Text="针对原生陀螺仪映射" FontSize="11.5" FontWeight="Bold"
                           Foreground="{StaticResource AccentInk}" LineHeight="18" Width="276"/>
                <TextBlock Canvas.Left="460" Canvas.Top="76" FontSize="10" LineHeight="16" Width="276"
                           Foreground="{StaticResource T3}" TextWrapping="Wrap"
                           Text="只调灵敏度，不改方向；不影响右摇杆映射。"/>
                <TextBlock Canvas.Left="460" Canvas.Top="130" FontSize="10" LineHeight="15" Width="276"
                           Foreground="{StaticResource T4}" TextWrapping="Wrap"
                           Text="右摇杆映射在「陀螺仪与震动」页。"/>
            </Canvas>
        </ContentControl>

            </Canvas>
            </Canvas>
        </ScrollViewer>

        <!-- ═══════ 滚动条（自绘玻璃滑块）══════════════════════════════════════
             内置滚动条已隐藏（VerticalScrollBarVisibility=Hidden），这里只画 8×72 的玻璃条，
             位置与拖动由 code-behind 按 VerticalOffset / ScrollableHeight 计算。
             外层 Canvas 不设背景，空白区域不会挡内容区的滚轮。 -->
        <Canvas x:Name="BarLayer" Canvas.Left="240" Canvas.Top="48" Width="804" Height="722">
            <Grid x:Name="ScrollThumb" Width="12" Height="240" Canvas.Left="764" Canvas.Top="6"
                  Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="ScrollThumb_MouseLeftButtonDown"
                  MouseMove="ScrollThumb_MouseMove"
                  MouseLeftButtonUp="ScrollThumb_MouseLeftButtonUp"
                  MouseWheel="ScrollThumb_MouseWheel">
                <Border Width="8" CornerRadius="4" BorderBrush="#1FFFFFFF" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#21DCE9FF" Offset="0"/>
                            <GradientStop Color="#0DDCE9FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="8" ShadowDepth="2" Direction="270" RenderingBias="Quality"/>
                    </Border.Effect>
                </Border>
            </Grid>
        </Canvas>

        <!-- ═══════ 校准二级面板：玻璃板 + 上沿边光 + 一行引导 / 一条进度 / 一行状态 ═══════
             材质与卡片同源（Squircle 24 / 同一套 sheen / 更重的投影），但多垫一层 90% 暗底——
             卡片背后只有页面底色，弹窗背后有内容，不加暗底就会透字。 -->
        <Grid x:Name="CalibrationOverlay" Canvas.Left="0" Canvas.Top="0" Width="1060" Height="840"
              Visibility="{Binding IsCalibrationPanelOpen, Converter={StaticResource BoolVis}}">
            <Rectangle Fill="#DB05050C"/>

            <ContentControl Width="560" Height="232" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Style="{StaticResource CardBase}"
                            ui:Glass.Radius="24" ui:Glass.Smoothing="0.62"
                            ui:Glass.Shadow="Card"
                            BorderThickness="1" BorderBrush="#1AFFFFFF">
                <ContentControl.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#E61A1524" Offset="0"/>
                        <GradientStop Color="#EB15181F" Offset="0.5"/>
                        <GradientStop Color="#ED121820" Offset="1"/>
                    </LinearGradientBrush>
                </ContentControl.Background>

                <Grid>
                    <!-- 上沿边光：只打在这一条边上，不进入板内；下面压 1px 深色收口给厚度 -->
                    <Rectangle Height="1.4" VerticalAlignment="Top" Margin="17,0,17,0" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00DCEBFF" Offset="0"/>
                                <GradientStop Color="#C4DCEBFF" Offset="0.5"/>
                                <GradientStop Color="#00DCEBFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Height="1" VerticalAlignment="Top" Margin="17,1.4,17,0" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#33000000" Offset="0.5"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Grid Margin="36,46,36,0" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 第一行：引导 -->
                        <TextBlock Grid.Row="0" Text="{Binding CalibrationInstruction}"
                                   FontSize="13.5" LineHeight="22" TextWrapping="Wrap"
                                   Foreground="{StaticResource T1}" Opacity="0.92"/>

                        <!-- 第二行：进度（2px，0% 时只是一条极淡的轨） -->
                        <Grid Grid.Row="2" Height="2">
                            <Border Background="#17FFFFFF" CornerRadius="1"/>
                            <Border HorizontalAlignment="Left" CornerRadius="1"
                                    Width="{Binding CalibrationBarWidth}" Background="#E65C9CFF">
                                <Border.Effect>
                                    <DropShadowEffect Color="#5C9CFF" Opacity="0.38" BlurRadius="9"
                                                      ShadowDepth="0" Direction="270" RenderingBias="Quality"/>
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <!-- 第三行：状态 + 百分比 -->
                        <Grid Grid.Row="4">
                            <TextBlock Text="{Binding CalibrationStatusText}" FontSize="11.5" LineHeight="17"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,64,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource T4}"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CalibrationFinished}" Value="True"/>
                                                    <Condition Binding="{Binding CalibrationSuccess}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CalibrationFinished}" Value="True"/>
                                                    <Condition Binding="{Binding CalibrationSuccess}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="#E9A1A1"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CalibrationPercentText}" FontSize="11.5" LineHeight="17"
                                       HorizontalAlignment="Right" Foreground="{StaticResource AccentInk}"
                                       Visibility="{Binding CalibrationPercentVisible, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                    </Grid>

                    <!-- 右下：关闭 + 主按钮（三态互斥） -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,36,32">
                        <Button Width="96" Height="36" Content="关闭" Margin="0,0,12,0"
                                Style="{StaticResource ModalGhostButton}"
                                Command="{Binding CloseCalibrationCommand}"/>
                        <Grid Width="128" Height="36">
                            <Button Content="开始校准" Style="{StaticResource ModalPrimaryButton}"
                                    Effect="{StaticResource ButtonGlow}"
                                    Command="{Binding StartCalibrationCommand}"
                                    IsEnabled="{Binding CalibrationCanStart}"
                                    Visibility="{Binding CalibrationStartVisible, Converter={StaticResource BoolVis}}"/>
                            <Button Content="重新校准" Style="{StaticResource ModalPrimaryButton}"
                                    Effect="{StaticResource ButtonGlow}"
                                    Command="{Binding StartCalibrationCommand}"
                                    Visibility="{Binding CalibrationRedoVisible, Converter={StaticResource BoolVis}}"/>
                            <Button Content="取消校准" Style="{StaticResource ModalPrimaryButton}"
                                    Effect="{StaticResource ButtonGlow}"
                                    Command="{Binding CloseCalibrationCommand}"
                                    Visibility="{Binding IsCalibrating, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ContentControl>
        </Grid>

    </Canvas>
</UserControl>
